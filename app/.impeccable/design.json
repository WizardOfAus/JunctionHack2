  "narrative": {
    "northStar": "Little steps, closer to home",
    "overview": "Koti uses forest navigation, a warm white workspace and green actions to make money decisions feel calm and approachable. Manrope provides a rounded, geometric voice; lilac and peach add playfulness to lessons without competing with financial information. The repeated home motif connects the brand mark, illustration and learning milestones.\n\nThe interface is compact but readable. Soft panels separate activities, while rules and aligned numbers make evidence inspectable. Learning rewards belong to the learning path; financial amounts retain their own labels and tabular figures. This records the implemented visual system, not a claim of bank endorsement or a completed design-process certification.",
    "keyCharacteristics": [
      "Forest navigation and warm, lightly bordered surfaces.",
      "Rounded geometric typography with prominent, aligned money figures.",
      "Pastel learning diagrams and a recurring home motif.",
      "Short state transitions, visible focus and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Meaning Before Colour Rule",
        "body": "Pair financial and learning states with words, amounts or icons; colour alone does not carry the answer.",
        "section": "colors"
      },
      {
        "name": "The Readable Context Rule",
        "body": "Keep financial explanations at the implemented 13px context size or 14px body size; reserve 12px for supporting labels and metadata.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep content panels flat. Reserve cast shadows for dialogs and transient status feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared Manrope face and tabular figures for money.",
      "Do keep meaningful labels and explanatory text beside diagrams, forecasts and progress.",
      "Do preserve the forest, green and warm-paper relationship, using lilac and peach for learning and category distinctions.",
      "Do retain visible keyboard focus, native control semantics and reduced-motion behavior.",
      "Do stack the workspace and expose bottom navigation at the mobile breakpoint."
    ],
    "donts": [
      "Don't replace financial context with tiny metadata styling.",
      "Don't imply that XP is money or that an illustrative forecast is a completed transfer.",
      "Don't add shadows to ordinary content cards.",
      "Don't use decorative glyphs instead of the implemented SVG icon language."
    ]
  }
}
