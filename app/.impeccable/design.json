    {
      "name": "Home Goal Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat, warm container for a labelled goal and progress.",
      "html": "<section class=\"ds-card\"><h2>Your first-home fund</h2><p class=\"ds-amount\"><strong>\u20ac0</strong> <span>of \u20ac20,000</span></p><div class=\"ds-track\" role=\"progressbar\" aria-label=\"Home deposit goal\" aria-valuenow=\"0\" aria-valuemin=\"0\" aria-valuemax=\"100\"><span></span></div><p class=\"ds-note\">Editable demo goal. Existing home savings are not known from transactions.</p></section>",
      "css": ".ds-card{font-family:Manrope,Arial,sans-serif;max-width:310px;background:#fffefa;color:var(--ink,#203d31);border:1px solid var(--line,#e2e7dc);border-radius:var(--radius,16px);padding:23px}.ds-card h2{font-size:14px;line-height:1.25;font-weight:750;margin:0}.ds-amount{font-variant-numeric:tabular-nums;margin:14px 0 0}.ds-amount strong{font-size:24px;letter-spacing:-.03em;font-weight:750}.ds-amount span{font-size:12px;color:var(--muted,#617064)}.ds-track{height:7px;background:#e9eee1;border-radius:7px;overflow:hidden;margin-top:12px}.ds-track>span{display:block;background:#709445;height:100%;width:0}.ds-note{font-size:13px;line-height:1.7;color:var(--muted,#617064);margin:12px 0 0}"
    },
    {
      "name": "Lesson Answer",
