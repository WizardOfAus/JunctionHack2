      "description": "Native choice control with selected and correct feedback surfaces.",
      "html": "<label class=\"ds-answer\"><input type=\"radio\" name=\"ds-answer\"><span>A reserve protects room for surprises.</span></label>",
      "css": ".ds-answer{font-family:Manrope,Arial,sans-serif;display:flex;align-items:center;gap:12px;padding:17px 16px;border:1px solid #d9e2cf;border-radius:10px;cursor:pointer;font-size:14px;line-height:1.65;background:#fff;color:var(--ink,#203d31)}.ds-answer input{width:17px;height:17px;flex-shrink:0;accent-color:var(--green,#387c36)}.ds-answer:has(input:checked){border-color:#71975b;background:#f0f6e8}.ds-answer input:focus-visible{outline:3px solid #739b47;outline-offset:4px;}.ds-answer.ds-correct{background:#e9f1da}"
    }
