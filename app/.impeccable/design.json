      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:15px;border:0;border-radius:9px;min-height:46px;padding:12px 20px;font-weight:700;font-size:13px;line-height:1.4;cursor:pointer;transition:background 150ms ease,transform 150ms ease;font-family:Manrope,Arial,sans-serif;background:var(--green,#387c36);color:#fff;}.ds-button-primary:hover{background:#2b652b;}.ds-button-primary:focus-visible{outline:3px solid #739b47;outline-offset:4px;}.ds-button-primary:active{transform:scale(.98)}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
