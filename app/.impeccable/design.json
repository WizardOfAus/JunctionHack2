      "kind": "input",
      "refersTo": "input",
      "description": "Labelled editable currency amount; source behavior commits on blur or Enter.",
      "html": "<label class=\"ds-field\"><span>Emergency cash reserve</span><span class=\"ds-money\"><span>\u20ac</span><input type=\"number\" value=\"300\" min=\"0\" step=\"1\"></span><small>Editable demo assumption.</small></label>",
      "css": ".ds-field{font-family:Manrope,Arial,sans-serif;display:flex;flex-direction:column;gap:7px;color:var(--ink,#203d31)}.ds-field>span:first-child{font-size:12px;font-weight:700}.ds-money{position:relative;display:flex;align-items:center}.ds-money>span{position:absolute;left:12px;font-size:13px;color:var(--muted,#617064)}.ds-money input{font-family:Manrope,Arial,sans-serif;width:100%;min-width:0;min-height:43px;border:1px solid #cfd9c5;border-radius:8px;padding:10px 12px 10px 29px;background:#fffefa;color:var(--ink,#203d31);font-size:16px;font-variant-numeric:tabular-nums;caret-color:var(--forest,#183f32)}.ds-money input:focus-visible{outline:3px solid #739b47;outline-offset:4px;}.ds-field small{font-size:13px;line-height:1.6;color:var(--muted,#617064)}"
    },
