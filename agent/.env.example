# Copy to .env (Git ignores it). `vite dev` and `flue run` load it automatically.

# Model provider key. Any provider Flue/Pi supports works:
# https://pi.dev/docs/latest/providers#api-keys
ANTHROPIC_API_KEY=

# Optional. Model id as provider/model. Default: anthropic/claude-sonnet-5-5
# KOTI_MODEL=anthropic/claude-sonnet-5-5

# Optional. Path to the imported dataset. Default: data/koti.db
# KOTI_DB_PATH=data/koti.db

# Optional. Last day of history the agent can see. Default: current historyThrough in app/data/demo-clock.json
# For the optional September backtest: KOTI_DATA_CUTOFF=2026-08-31

# Optional. Port for the built server (npm start). Default: 3000
# PORT=3000

# Optional. Shared secret between the app server and this agent server.
# When set, /agents/* requires "Authorization: Bearer <token>". Use the same value
# as KOTI_AGENT_TOKEN in app/.dev.vars.
# KOTI_AGENT_TOKEN=
